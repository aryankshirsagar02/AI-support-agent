# SupportIQ AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Provider Configuration (Optional - built-in grounded generator works without keys)
# LLM_PROVIDER=openai | gemini | custom
LLM_PROVIDER=builtin
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CUSTOM_LLM_ENDPOINT=

# Brand Configuration Path
BRAND_CONFIG_PATH=config/brand_config.yaml

# Data Paths
RAW_DATA_PATH=data/raw/twcs.csv
PROCESSED_DATA_DIR=data/processed
GOLDEN_SET_PATH=data/golden/golden_set.csv
EVALUATION_RESULTS_DIR=data/evaluation
